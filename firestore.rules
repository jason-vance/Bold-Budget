rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    // Users

    match /Users/{userId} {
      allow read: if loggedIn();
      allow write: if belongsToRequester(userId);
    }

    // Admin

    match /Admin/{userId} {
      allow read: if loggedIn();
    }

    function requesterIsAdmin() {
    	return exists(/databases/$(database)/documents/Admin/$(userId()))
    }

    // Budgets

    match /Budgets/{budgetId} {
    	allow read: if userId() in resource.data.users;
      allow create, delete: if budgetOwnedByRequester(budgetId);
      // Owners may update freely (rename, manage members). An invitee with a pending
      // invitation may update only to add themselves to the members array, and any member
      // may update only to remove themselves (i.e. leave the budget).
      allow update: if budgetOwnedByRequester(budgetId)
      							 || requesterIsAcceptingInvite(budgetId)
      							 || requesterIsLeaving(budgetId);
    }

    function requesterIsBudgetUser(budgetId) {
    	return budgetUserExists(budgetId, userId())
    }

    function budgetOwnedByRequester(budgetId) {
    	return budgetUser(budgetId, userId()).role == 'owner'
    }

    function budget(budgetId) {
    	return get(/databases/$(database)/documents/Budgets/$(budgetId)).data
    }

    // The requester is accepting an invitation: they hold a pending invite for this budget
    // and the only change is adding themselves to the members array (nothing else touched).
    function requesterIsAcceptingInvite(budgetId) {
    	return hasInvitation(budgetId)
    				 && !(userId() in existingData().users)
    				 && userId() in incomingData().users
    				 && incomingData().users.size() == existingData().users.size() + 1
    				 && incomingData().users.hasAll(existingData().users)
    				 && incomingData().name == existingData().name
    }

    // The requester is leaving: they're currently a member and the only change is removing
    // themselves from the members array (nothing else touched). Lets viewers leave, not just owners.
    function requesterIsLeaving(budgetId) {
    	return userId() in existingData().users
    				 && !(userId() in incomingData().users)
    				 && incomingData().users.size() == existingData().users.size() - 1
    				 && existingData().users.hasAll(incomingData().users)
    				 && incomingData().name == existingData().name
    }

    function hasInvitation(budgetId) {
    	return exists(/databases/$(database)/documents/BudgetInvitations/$(budgetId + '_' + userId()))
    }

    // BudgetUsers

    match /Budgets/{budgetId}/Users/{userId} {
    	allow read: if requesterIsBudgetUser(budgetId);
    	// Own membership doc, either at budget creation (before the budget exists, always as owner)
    	// or when accepting an invitation, in which case the role must match the invite (so an
    	// invitee can't grant themselves a higher role than they were offered).
    	allow create: if userId == userId() && (
    									 (budgetDoesNotExist(budgetId) && incomingData().role == 'owner')
    									 || (hasInvitation(budgetId) && incomingData().role == invitationRole(budgetId))
    								 );
    	// Owners may change members' roles (owner ⇄ viewer).
    	allow update: if budgetOwnedByRequester(budgetId);
    	// Owners may remove any member; any member may remove themselves (i.e. leave the budget).
    	allow delete: if budgetOwnedByRequester(budgetId) || userId == userId();
    }

    function budgetDoesNotExist(budgetId) {
    	return !exists(/databases/$(database)/documents/Budgets/$(budgetId))
    }

    // The role recorded on the requester's pending invitation for this budget. Legacy invites
    // predate the field and were all equal co-owners.
    function invitationRole(budgetId) {
    	return get(/databases/$(database)/documents/BudgetInvitations/$(budgetId + '_' + userId())).data.get('role', 'owner')
    }

    function budgetUserExists(budgetId, userId) {
    	return exists(/databases/$(database)/documents/Budgets/$(budgetId)/Users/$(userId))
    }

    function budgetUser(budgetId, userId) {
    	return get(/databases/$(database)/documents/Budgets/$(budgetId)/Users/$(userId)).data
    }

    // BudgetInvitations

    match /BudgetInvitations/{inviteId} {
    	allow read: if requesterIsInvitee() || requesterIsInviter();
    	// Only an owner of the budget may invite, and only in their own name.
    	allow create: if incomingData().inviterUserId == userId()
    								 && budgetOwnedByRequester(incomingData().budgetId);
    	// The invitee (accept/decline) or the inviter (cancel) may remove it.
    	allow delete: if requesterIsInvitee() || requesterIsInviter();
    }

    function requesterIsInvitee() {
    	return existingData().inviteeUserId == userId()
    }

    function requesterIsInviter() {
    	return existingData().inviterUserId == userId()
    }

    // TransactionCategories

    match /Budgets/{budgetId}/TransactionCategories/{categoryId} {
    	allow read: if requesterIsBudgetUser(budgetId);
      allow create, update, delete: if budgetOwnedByRequester(budgetId);
    }

    // Transactions

    match /Budgets/{budgetId}/Transactions/{transactionId} {
    	allow read: if requesterIsBudgetUser(budgetId);
      allow create, update, delete: if budgetOwnedByRequester(budgetId);
    }

    // RecurringExpenses

    match /Budgets/{budgetId}/RecurringExpenses/{recurringExpenseId} {
    	allow read: if requesterIsBudgetUser(budgetId);
      allow create, update, delete: if budgetOwnedByRequester(budgetId);
    }

    // Accounts

    match /Budgets/{budgetId}/Accounts/{accountId} {
    	allow read: if requesterIsBudgetUser(budgetId);
      allow create, update, delete: if budgetOwnedByRequester(budgetId);
    }

    // Feedback

    match /Feedback/{feedbackId} {
      allow read: if requesterIsAdmin();
      allow create: if requesterIsFeedbackCreator();
      allow update: if requesterIsAdmin();
    }

    function requesterIsFeedbackCreator() {
    	return belongsToRequester(incomingData().userId)
    }

    // Misc

    function loggedIn() {
      return userId() != null
    }

    function userId() {
      return request.auth.uid
    }

    function belongsToRequester(userId) {
      return userId() == userId
    }

    // [READ] Data that exists on the Firestore document
    function existingData() {
      return resource.data;
    }

    // [WRITE] Data that is sent to a Firestore document
    function incomingData() {
      return request.resource.data;
    }

  }
}
